{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gridster",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Hourly sweep to expire Linden-paid Gridster Plus once
    // plus_current_period_end passes - see worker/routes/expire-linden-plus-memberships.js.
    "crons": ["0 * * * *"]
  }
}
